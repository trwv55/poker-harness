# syntax=docker/dockerfile:1

# Один образ на три сервиса (`bot`, `worker`, `migrate`) — различает их команда в
# docker-compose.yml, а не отдельная сборка. Код у них общий, и один образ — это
# гарантия, что бот, записавший файл, и воркер, читающий его, собраны из одного
# коммита; два образа были бы лишним способом развезти версии тех процессов,
# которые обязаны быть одной версией.
#
# ====== ПОЧЕМУ ВЕРСИЯ PYTHON ЗАПИНЕНА ТОЧНО (а не `python:3-slim`) ======
#
# Это не косметика и не привычка. `requires-python` в pyproject — `>=3.12`, и
# `uv.lock` уже разрешён в том числе под 3.14; значит, ровно эта строка решает, в
# каком из двух миров живёт воркер:
#
# 1. **Метод старта процессов.** Тяжёлый счёт воркер уводит в
#    `ProcessPoolExecutor` (`worker/main.py`, задача 18). На Linux дефолтный
#    `multiprocessing`-метод — `fork` для 3.12 и 3.13, но начиная с 3.14 это
#    `forkserver`. КОРРЕКТНОСТЬ от этого не зависит и зависеть не имеет права:
#    так прямо разобрано в докстринге `_enqueue_deep_dive_for_missing_hand`
#    (`tests/test_worker_pipeline.py`) — тест там переписан именно затем, чтобы
#    не опираться на наследование памяти. Зависит ЦЕНА: под `fork` подпроцесс
#    наследует прогретую память родителя (модульные кэши, таблица эквити), под
#    `forkserver` каждый стартует с чистого импорта и греет своё заново.
#    Развёрнуто — в комментарии у самого `ProcessPoolExecutor` в
#    `worker/main.py`. Апгрейд минорной версии обязан быть отдельным осознанным
#    решением, а не побочным эффектом пересборки образа через полгода.
#    (Правка ревью fix round 1: прежняя редакция ссылалась на докстринг
#    `worker/main.py`, которого не было — рассуждение жило только в тесте, и
#    ссылка была выдумана. Теперь комментарий в `worker/main.py` существует.)
# 2. **Колёса eval7.** У `eval7==0.1.11` в `uv.lock` НЕТ sdist — только бинарные
#    колёса, и под Linux они собраны исключительно под x86_64 (cp312, cp313,
#    cp314, cp315). Отсюда следствие, о котором знает docker-compose.yml
#    (`platform: linux/amd64`): образ собирается и работает только на amd64,
#    потому что под linux/arm64 eval7 не из чего поставить — ни колеса, ни
#    исходников. Смена минорной версии Python здесь тоже не бесплатна: она меняет
#    тег колеса, а не только интерпретатор.

FROM python:3.12-slim AS builder

# uv — готовым бинарником из официального образа astral, с пином версии по той же
# причине, что и Python: сборка обязана быть воспроизводимой.
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=python3.12 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Два `uv sync` вместо одного — ради кэша слоёв: зависимости меняются вместе с
# `uv.lock` (редко), код — каждым коммитом (часто). `--frozen`: лок берётся как
# есть, сборка не имеет права его пересчитать; `--no-dev`: pytest, ruff, pyright
# и testcontainers в проде не нужны.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY alembic.ini ./
COPY migrations ./migrations
COPY src ./src
# `--no-editable`: по умолчанию uv ставит сам проект РЕДАКТИРУЕМЫМ, то есть
# кладёт в site-packages не код, а ссылку на /app/src — и финальный образ,
# который забирает только `.venv`, падает на `ModuleNotFoundError: harness`
# (поймано прогоном `docker compose run --rm migrate`, а не рассуждением).
# С флагом проект собирается колесом и уезжает внутрь `.venv` целиком.
RUN uv sync --frozen --no-dev --no-editable


FROM python:3.12-slim

# Непривилегированный пользователь: в /data лежат присланные игроками файлы, и
# владеть ими root не должен. Каталог заводится ЗДЕСЬ и с этим владельцем именно
# для того, чтобы пустой именованный том Docker при первом монтировании
# унаследовал права от образа, а не остался root-only. Сам путь тома задан в
# docker-compose.yml переменной `DATA_DIR` — здесь только каталог.
RUN useradd --create-home --uid 10001 harness \
    && mkdir -p /data \
    && chown harness:harness /data

WORKDIR /app

COPY --from=builder --chown=harness:harness /app/.venv /app/.venv
COPY alembic.ini ./
COPY migrations ./migrations

# Окружение активируется PATH'ом, а `uv run` в рантайме не зовётся сознательно:
# он при каждом старте сверяет `uv.lock` с окружением, то есть требует и права
# на запись, и (в худшем случае) сеть — тогда как окружение уже собрано на этапе
# build и меняться не должно. По той же причине uv в финальный образ не попадает.
# PYTHONUNBUFFERED: без него stdout в контейнере блочно буферизуется, и JSON-логи
# structlog появляются в `docker compose logs` пачками с опозданием.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER harness

# CMD нет намеренно: у образа нет «главного» процесса — их три, и выбирает
# команда сервиса в docker-compose.yml. Запуск без команды честно падает с
# «no command specified», а не стартует случайно выбранный процесс.
