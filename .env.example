# Шаблон окружения для деплоя. Скопировать РЯДОМ с docker-compose.yml под именем
# `.env` и заполнить значения:
#
#   cp .env.example .env
#
# Сам `.env` в репозиторий не едет никогда: он в .gitignore и в pre-push хуке
# (docs/publishing-policy.md). В этом файле значений нет и быть не должно — здесь
# только имена и то, что каждое имя означает.
#
# Один и тот же файл compose читает ДВАЖДЫ и по-разному:
#   * как источник подстановок `${...}` в самом docker-compose.yml — так туда
#     попадает `PG_PASSWORD`;
#   * как `env_file` сервисов `bot` и `worker` — так туда попадают токен бота,
#     ключ провайдера, модели и лимиты.
# Значения без кавычек, без завершающих пробелов и без `#` внутри.
# `PG_PASSWORD` — только буквы, цифры, `_` и `-`: compose подставляет его сырым в
# `DATABASE_URL` вида `postgresql://harness:<пароль>@postgres/...`, и символы `%`,
# `&`, `=`, `@`, `/`, `:`, `?`, `#` там читаются как разметка URL — Postgres получит
# другой пароль, чем ему задали при создании тома (найдено на первом живом запуске
# 2026-09-05: `password authentication failed` на пустом свежем томе).
#
# ВАЖНО ПРИ ПЕРВОМ ЗАПУСКЕ: `Config.from_env()` требует ВСЕ шесть своих
# переменных (`LLM_*`, `DATABASE_URL`, `TELEGRAM_TOKEN`) у ОБОИХ процессов — и
# у бота, и у воркера, — даже на сценарии HH-скана, где модель не зовётся ни
# разу. Пустая `LLM_VISION_MODEL` уронит бота на старте с явным сообщением о
# ней, и это не баг конфигурации, а её условие: заполнять надо всё, что ниже
# не помечено как необязательное.
#
# Чего здесь НЕТ и быть не должно: `DATABASE_URL` и `DATA_DIR`. Их задаёт
# docker-compose.yml на каждый сервис (у миграций синхронный драйвер, у
# приложений — асинхронный; `DATA_DIR` читает только бот), и `environment` в
# compose перекрывает `env_file` — строка в `.env` на них не повлияет, а только
# создаст ложное впечатление, что повлияла.
#
# НЕОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ЗДЕСЬ ЗАКОММЕНТИРОВАНЫ, И ЭТО ПРАВИЛО, А НЕ СТИЛЬ.
# `env_file` в Compose передаёт строку `ИМЯ=` как ПУСТОЕ ЗНАЧЕНИЕ, а не как
# отсутствие переменной: дефолт в коде тогда не применяется, и необязательная
# переменная ведёт себя как заданная пустышкой. Поэтому всякая новая
# необязательная строка добавляется сюда закомментированной — раскомментировал
# значит задал. Со стороны кода тот же случай прикрыт вторым концом
# (`optional_env`, `platform/config.py`: пустое значение считается незаданным),
# но полагаться на один конец нельзя — найдено ревью задачи 20 ровно на этом
# файле.

# --- Postgres ---------------------------------------------------------------
# Пароль пользователя `harness`. Отсюда его берут и сам Postgres, и DSN обоих
# приложений, и DSN миграций — все три собираются в docker-compose.yml.
PG_PASSWORD=

# --- Телеграм ---------------------------------------------------------------
# Токен бота от @BotFather. Нужен и боту (long polling), и воркеру (он шлёт
# результат разбора сам, `TelegramSender`).
TELEGRAM_TOKEN=

# --- Провайдер LLM ----------------------------------------------------------
# Ключ провайдера читает PydanticAI, каждый провайдер — свою переменную (для
# Anthropic это `ANTHROPIC_API_KEY`, для другого вендора имя будет другим и его
# надо дописать сюда же).
#
# СТРОКА РАСКОММЕНТИРОВАНА С ЗАДАЧ 21 (изложение вердикта) и 22 (зрение): пока
# продукт не звал модель ни на одном пути, ключ был необязателен — теперь оба
# места, где в системе живёт LLM, существуют, и на сервере ключ обязателен.
# Исключение из общего правила файла ровно одно и вот какое: наш код этот ключ
# НЕ ЧИТАЕТ, его читает библиотека, поэтому пустое значение не роняет процесс
# при старте, как остальные обязательные переменные, — отказ приходит на первом
# вызове модели. `pydantic_ai/providers/anthropic.py` делает
# `api_key = api_key or os.getenv('ANTHROPIC_API_KEY')`, затем
# `if not api_key: raise missing_api_key_error(...)` (сверено с установленной
# библиотекой), то есть пустое и отсутствующее дают один и тот же `UserError` с
# именем переменной, и никакого 401 не будет. HH-скан при этом по-прежнему
# считается нулём вызовов модели и работает без ключа — проверить это на сервере
# дешевле всего именно им (docs/deploy-runbook.md).
#
# НА СЕРВЕРЕ КЛЮЧ ОБЯЗАН БЫТЬ НОВЫМ: тот, что использовался на приёмке, живёт в
# `.env` на Маке; выпуск отдельного ключа для VPS — шаг runbook'а, а не
# формальность (отозвать его можно, не трогая рабочую машину).
ANTHROPIC_API_KEY=

# Модели по назначениям, строкой `"<провайдер>:<модель>"` — спека §7. Смена
# модели или вендора это смена вот этой строки, а не правка кода. Стартовые
# классы из спеки: извлечение — Sonnet-класс (точность критична), изложение —
# Haiku-класс (модель только пересказывает готовые числа).
LLM_VISION_MODEL=
LLM_VERDICT_MODEL=

# Вторая ступень каскада зрения (задача 22): дорогая модель, на которой экран
# перечитывается, если не сошлась хоть одна контрольная сумма (банк, кнопка,
# карты у места против карт в логе, эквити). НЕОБЯЗАТЕЛЬНА и поэтому
# закомментирована — правило шапки этого файла: раскомментировал значит задал.
# Не задана — каскада нет, и первая же несошедшаяся сверка уходит вопросом
# игроку. Это рабочий режим, а не отказ: вопрос игроку по архитектуре
# предохранитель, а не провал (скрин — гипотеза, не факт).
#
# ЦЕНА КАСКАДА, ЗАМЕР ПО `llm_calls` за 2026-09-06 (ручное тестирование зрения
# владельцем, 137 вызовов, $4.93): первая ступень — 88 удачных чтений на $2.4707
# ($0.028 за чтение), вторая — 31 перечитывание на $2.2286 ($0.072 за штуку).
# То есть на вторую ступень ушли 35% чтений, и стоила она почти столько же,
# сколько все первые: средний экран с каскадом обходится в $0.053 вместо $0.028.
# Решение «включать или нет» — про качество против денег, и принимает его
# владелец; runbook рекомендует включить на старте и пересчитать долю по журналу
# через неделю (SQL — в docs/deploy-runbook.md).
#LLM_VISION_FALLBACK_MODEL=

# Кросс-процессные лимиты провайдер-слоя (целые числа): сколько вызовов модели
# одновременно и сколько в минуту на всю систему. Считаются в Postgres, поэтому
# при `--scale worker=N` лимит остаётся общим, а не умножается на N.
#
# Стартовые значения для продакшена — 4 и 20, обоснование из журнала `llm_calls`
# и из устройства воркера расписано в docs/deploy-runbook.md («Лимиты и деньги»).
# Коротко: 4 — это потолок одного контейнера воркера (`WORKER_CONCURRENCY`,
# дефолт 4), выше него один контейнер всё равно не поднимется, а ниже —
# сознательное торможение; 20 в минуту при латентности вызова 10–13с одним
# воркером физически не выбирается и потому работает предохранителем на случай
# второй реплики или цикла ретраев. Это НЕ измеренный оптимум под нагрузкой:
# нагрузки пока не было, замер — ручное тестирование одним человеком.
LLM_MAX_CONCURRENCY=
LLM_MAX_PER_MINUTE=

# --- Воркер -----------------------------------------------------------------
# Число корутин одного контейнера воркера; НЕОБЯЗАТЕЛЬНА, дефолт в коде — 4,
# поэтому строка закомментирована (см. правило в шапке файла). Это НЕ размер
# процессного пула: про его связь с числом ядер и с `--scale worker=2` написано
# в docker-compose.yml, у сервиса `worker`.
#WORKER_CONCURRENCY=
