# Кэш равновесий пуш-фолда: чистый производный артефакт, считается кодом за секунды
# и восстанавливается при пустом кэше. В отличие от таблицы эквити (её генерация —
# минуты, поэтому она коммитится) держать его в истории незачем.
src/harness/analysis/tools/data/nash_hu_*.json

# Дисковый кэш эквити мультивея (задача 13): тот же принцип — чистый производный
# артефакт, восстанавливается пересчётом за секунды при пустом кэше.
