# Контекст сборки — только то, из чего собирается образ. Всё остальное сюда не
# едет по двум причинам сразу: скорость (контекст целиком уходит демону на каждую
# сборку) и приватность — в рабочем дереве лежат реальные руки игроков, и попасть
# в слой образа они не должны ни случайной строкой COPY, ни через кэш билдера.
# Список зеркалит docs/publishing-policy.md; исключение одно — `src/harness/
# parsers/prompts/`, которых нет в репозитории, но которые нужны в проде, поэтому
# они НЕ исключаются здесь.

# Приватные данные (см. docs/publishing-policy.md)
data/
fixtures/
evals/
reports/
.claude/

# Производные кэши, которые по той же причине не коммитятся (см. .gitignore):
# иначе образ одного и того же коммита получается разным в зависимости от того,
# что накопилось в рабочем дереве сборщика. Восстанавливаются пересчётом за
# секунды. Таблица эквити `eq169.json` — НЕ отсюда: она коммитится (её генерация
# — минуты) и в образе нужна.
src/harness/analysis/tools/data/nash_hu_*.json
src/harness/analysis/tools/data/equity_mc_cache.json

# Секреты
.env

# История и служебное
.git/
.github/
.githooks/
.superpowers/
docs/

# Локальное окружение разработки: своё окружение образ собирает сам, из uv.lock
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
tests/
scripts/

# macOS
.DS_Store
